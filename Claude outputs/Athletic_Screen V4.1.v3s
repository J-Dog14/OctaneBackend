File_Open 
/FILE_NAME=<?=$working_directory . "CMJ*.c3d"?>
;

File_Open 
/FILE_NAME=<?=$working_directory . "PPU*.c3d"?>
;

File_Open 
/FILE_NAME=<?=$working_directory . "DJ*.c3d"?>
;

File_Open
 /FILE_NAME=<?=$working_directory . "SLVR*.c3d"?>
! /SUFFIX=
! /SET_PROMPT=File_Open
! /FILTER=
! /ON_FILE_NOT_FOUND=PROMPT
;

File_Open
 /FILE_NAME=<?=$working_directory . "SLVL*.c3d"?>
! /SUFFIX=
! /SET_PROMPT=File_Open
! /FILTER=
! /ON_FILE_NOT_FOUND=PROMPT
;

Create_Hybrid_Model
 /CALIBRATION_FILE=D:\Tramp Test\Templates\Model.C3D
! /SUFFIX=
! /RANGE=ALL_FRAMES
! /SET_PROMPT=Open standing file
;

Apply_Model_Template
 /CALIBRATION_FILE=D:\Tramp Test\Templates\Model.C3D
! /SUBJECT_PREFIX=
 /MODEL_TEMPLATE=D:\Tramp Test\Templates\Right_Hand.mdh
! /SET_PROMPT=Open model file
! /VIEW_BUILDMODEL_RESULTS=2
! /MISSING_TARGET_MESSAGE=FALSE
;

Set_Subject_Height
! /CALIBRATION_FILE=
! /PROMPT=
! /PROMPT_SIZE=90
! /HEIGHT=
/UNITS=inches
;

Set_Subject_Mass
! /CALIBRATION_FILE=
! /PROMPT=
! /PROMPT_SIZE=90
! /WEIGHT=
/UNITS=Lb
;

Assign_Model_File
! /CALIBRATION_FILE=
! /ADDITIONAL_CALIBRATION_FILES=
 /MOTION_FILE_NAMES= *DJ*.C3D+*CMJ*.C3D+*PPU*.C3D+*SLV*.C3D+*NMT*.C3D
! /REMOVE_EXISTING_ASSIGNMENTS=FALSE
;

Assign_Tags_To_Files
 /MOTION_FILE_NAMES=*CMJ*.C3D
! /QUERY=
 /TAGS=CMJ
;

Assign_Tags_To_Files
 /MOTION_FILE_NAMES=*PPU*.C3D
! /QUERY=
 /TAGS=PPU
;

Assign_Tags_To_Files
 /MOTION_FILE_NAMES=*DJ*.C3D
! /QUERY=
 /TAGS=DJ
;

Assign_Tags_To_Files
/MOTION_FILE_NAMES=*SLVL*.C3D
! /QUERY=
 /TAGS= Single Leg Vertical Left

;

Assign_Tags_To_Files
/MOTION_FILE_NAMES=*SLVR*.C3D
! /QUERY=
 /TAGS= Single Leg Vertical Right

;

Select_Active_File
/FILE_NAME=CMJ + PPU + DJ + Single Leg Vertical Left + Single Leg Vertical Right
! /QUERY=
;

Event_Explicit
/EVENT_NAME=START
/FRAME=1
! /TIME=
;

Event_Explicit
/EVENT_NAME=END
/FRAME=EOF
! /TIME=
;

Signal_Magnitude
 /SIGNAL_TYPES=FORCE
 /SIGNAL_FOLDER=ORIGINAL
 /SIGNAL_NAMES=FP3
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=FP3_Mag
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
;

Select_Active_File
/FILE_NAME=CMJ + PPU + Single Leg Vertical Left + Single Leg Vertical Right
! /QUERY=
;

Event_Threshold
/RESULT_EVENT_NAME=ON
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FP3_Mag
/SIGNAL_COMPONENTS=ALL
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=START
! /EXCLUDE_EVENTS=
/EVENT_SEQUENCE_INSTANCE=1
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=1
/THRESHOLD=20
/ON_ASCENT=TRUE
/ON_DESCENT=FALSE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

Event_Onset
/SIGNAL_TYPES=DERIVED
 /SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FP3_Mag
/EVENT_NAME=OFF
! /SELECT_X=TRUE
! /SELECT_Y=FALSE
! /SELECT_Z=FALSE
/THRESHOLD=20
/THRESHOLD_INSTANCE=1
! /BASELINE=0
! /FRAME_OFFSET=0
! /FRAME_WINDOW=8
! /ASCENDING=FALSE
/DESCENDING=TRUE
/START_AT_EVENT=START
/END_AT_EVENT=ON
;

Event_Global_Maximum
/RESULT_EVENT_NAME=Max_Force
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FP3_Mag
/SIGNAL_COMPONENTS=ALL
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=START+OFF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=FORCE
/SIGNAL_FOLDER=ORIGINAL
 /SIGNAL_NAMES=FP3
 /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=Max_Force
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
 /SIGNAL_COMPONENTS=Z
!/COMPONENT_SEQUENCE=Z
/EVENT_NAME=Max_Force
/EVENT_INSTANCE=1
 /GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=FRAME_NUMBERS
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=TIME
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=TIMEofOFF
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
/EVENT_NAME=OFF
/EVENT_INSTANCE=1
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=FRAME_NUMBERS
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=TIME
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=TIMEofON
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
/EVENT_NAME=ON
/EVENT_INSTANCE=1
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Subtract_Signals
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=TIMEofON+TIMEofOFF
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
/RESULT_NAME=JT
;

Select_Active_File
/FILE_NAME=DJ
! /QUERY=
;

Event_Threshold
/RESULT_EVENT_NAME=ON
/SIGNAL_TYPES=FORCE
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=FP3
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=START
! /EXCLUDE_EVENTS=
/EVENT_SEQUENCE_INSTANCE=1
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=1
/THRESHOLD=40
/ON_ASCENT=TRUE
/ON_DESCENT=FALSE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

Event_Threshold
/RESULT_EVENT_NAME=ON2
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FP3_Mag
/SIGNAL_COMPONENTS=ALL
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=ON
! /EXCLUDE_EVENTS=
/EVENT_SEQUENCE_INSTANCE=1
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=1
/THRESHOLD=40
/ON_ASCENT=TRUE
/ON_DESCENT=FALSE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

Event_Onset
/SIGNAL_TYPES=DERIVED
 /SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FP3_Mag
/EVENT_NAME=OFF
! /SELECT_X=TRUE
! /SELECT_Y=FALSE
! /SELECT_Z=FALSE
/THRESHOLD=20
/THRESHOLD_INSTANCE=1
! /BASELINE=0
! /FRAME_OFFSET=0
! /FRAME_WINDOW=8
! /ASCENDING=FALSE
/DESCENDING=TRUE
/START_AT_EVENT=ON
/END_AT_EVENT=ON2
;

Event_Global_Maximum
/RESULT_EVENT_NAME=Max_Force
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FP3_Mag
/SIGNAL_COMPONENTS=ALL
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=START+OFF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=FORCE
/SIGNAL_FOLDER=ORIGINAL
 /SIGNAL_NAMES=FP3
 /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=Max_Force
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
 /SIGNAL_COMPONENTS=Z
!/COMPONENT_SEQUENCE=Z
/EVENT_NAME=Max_Force
/EVENT_INSTANCE=1
 /GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=FRAME_NUMBERS
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=TIME
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=TIMEofOFF
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
/EVENT_NAME=OFF
/EVENT_INSTANCE=1
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=FRAME_NUMBERS
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=TIME
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=TIMEofON
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
/EVENT_NAME=ON
/EVENT_INSTANCE=1
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=FRAME_NUMBERS
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=TIME
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=TIMEofON2
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
/EVENT_NAME=ON2
/EVENT_INSTANCE=1
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Subtract_Signals
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=TIMEofON2+TIMEofOFF
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
/RESULT_NAME=JT
;

Subtract_Signals
/SIGNAL_TYPES=METRIC
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=TIMEofOFF+TIMEofON
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
/RESULT_NAME=CT
;

Select_Active_File
/FILE_NAME=CMJ + PPU + DJ + Single Leg Vertical Left + Single Leg Vertical Right
! /QUERY=
;

Evaluate_Expression
/EXPRESSION=(METRIC::PROCESSED::JT)^2
! /SIGNAL_TYPES=METRIC
! /SIGNAL_FOLDER=PROCESSED
 !/SIGNAL_NAMES=JT
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=JT_SQRD
 /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Multiply_Signals_By_Constant
 /SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=JT_SQRD
! /SIGNAL_COMPONENTS=
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=JT_xGRAV
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
 /CONSTANT=9.81
;

Divide_Signal_By_Constant
 /SIGNAL_TYPES=METRIC
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=JT_xGRAV
! /SIGNAL_COMPONENTS=
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=JH_M
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
 /CONSTANT=8
;

Multiply_Signals_By_Constant
 /SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=JH_M
! /SIGNAL_COMPONENTS=
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=JH_CM
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
 /CONSTANT=100
;

Divide_Signal_By_Constant
 /SIGNAL_TYPES=METRIC
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=JH_CM
! /SIGNAL_COMPONENTS=
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=JH_IN
 /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
 /CONSTANT=2.54
;

Divide_Signals
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=JH_IN+HEIGHT_IN
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
/RESULT_NAME=JH_DEC
;

Multiply_Signals_By_Constant
 /SIGNAL_TYPES=METRIC
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=JH_DEC
! /SIGNAL_COMPONENTS=
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=JH%
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
 /CONSTANT=100
;

Select_Active_File
/FILE_NAME=DJ
! /QUERY=
;

Divide_Signals
/SIGNAL_TYPES=METRIC
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=JH_M+CT
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
/RESULT_NAME=RSI_Pre
;

Multiply_Signals_By_Constant
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=RSI_Pre
/RESULT_TYPES=METRIC
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=RSI
/CONSTANT=2
;

Select_Active_File
/FILE_NAME=CMJ + PPU + DJ + Single Leg Vertical Left + Single Leg Vertical Right
! /QUERY=
;

!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
! This is the Lewis Formula for estimating peak power based on hump height in cm and body mass kg
! Peak Power (W) = 61.9*(jump height(cm)) + 36*(body mass (kg)) + 1,822
!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


Evaluate_Expression
/EXPRESSION=((61.9 * (METRIC::PROCESSED::JH_CM))+(36 * (METRIC::PROCESSED::MASS)) + 1822)
! /SIGNAL_TYPES=METRIC
! /SIGNAL_FOLDER=PROCESSED
! /SIGNAL_NAMES=
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=LEWIS_PEAK_POWER
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
! This is the Lewis Formula for estimating average power based on hump height in cm and body mass kg
! Avgerage Power (W) = 61.9*(jump height(cm)) + 36*(body mass (kg)) + 1,822
!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


Evaluate_Expression
/EXPRESSION=((21.2 * (METRIC::PROCESSED::JH_CM))+(23 * (METRIC::PROCESSED::MASS)) - 1393)
! /SIGNAL_TYPES=METRIC
! /SIGNAL_FOLDER=PROCESSED
! /SIGNAL_NAMES=
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=LEWIS_AVG_POWER
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Divide_Signals
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=LEWIS_PEAK_POWER+MASS_N
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
/RESULT_NAME=NORM_LEWIS_PEAK_POWER_N
;

Divide_Signals
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=LEWIS_PEAK_POWER+MASS
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
/RESULT_NAME=NORM_LEWIS_PEAK_POWER_KG
;

Select_Active_File
/FILE_NAME=CMJ + DJ + Single Leg Vertical Left + Single Leg Vertical Right
! /QUERY=
;

! New patch to do Sayer Power and use force plate derived power
Subtract_Constant_From_Signals
 /SIGNAL_TYPES=DERIVED
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=FP3_Mag
 /SIGNAL_COMPONENTS=Z
! /RESULT_TYPES=
! /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=NetFz
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
 /CONSTANT=(METRIC::PROCESSED::MASS * 9.81)
;

Divide_Signals
 /SIGNAL_TYPES=DERIVED
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=NetFz+MASS
 /RESULT_NAME=AccZ
;

Select_Active_File
/FILE_NAME=PPU
! /QUERY=
;

Event_Explicit
/EVENT_NAME=BASELINE_END
! /FRAME=
 /TIME=0.05
;

Metric_Mean
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=FP3Z_BASELINE_N
 /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=FORCE
 /SIGNAL_FOLDER=ORIGINAL
 /SIGNAL_NAMES=FP3
 /COMPONENT_SEQUENCE=Z
/EVENT_SEQUENCE=START_BASELINE_END
/EXCLUDE_EVENTS=
! /GENERATE_MEAN_AND_STDDEV=TRUE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Evaluate_Expression
/EXPRESSION=(METRIC::PROCESSED::FP3Z_BASELINE_N/9.81)
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
! /SIGNAL_COMPONENTS=
 /RESULT_TYPES=METRIC
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=MASS_EFF
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

! New patch to do Sayer Power and use force plate derived power
Subtract_Constant_From_Signals
 /SIGNAL_TYPES=DERIVED
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=FP3_Mag
 /SIGNAL_COMPONENTS=Z
 /RESULT_TYPES=DERIVED
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=NetFz
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
 /CONSTANT=(METRIC::PROCESSED::FP3Z_BASELINE_N)
;

Divide_Signals
 /SIGNAL_TYPES=DERIVED
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=NetFz+MASS_EFF
 /RESULT_NAME=AccZ
;

Select_Active_File
/FILE_NAME=CMJ + PPU + DJ + Single Leg Vertical Left + Single Leg Vertical Right
! /QUERY=
;

Indefinite_Integral
 /SIGNAL_TYPES=DERIVED
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=AccZ
 /RESULT_TYPES=DERIVED
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=VelZ
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
 /EVENT_SEQUENCE=START
! /EXCLUDE_EVENTS=
! /EVENT_INSTANCE=0
 /INITIAL_VALUES=0
;

! takes velo at mm*s to m*s
Multiply_Signals_By_Constant
 /SIGNAL_TYPES=DERIVED
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=VelZ
! /SIGNAL_COMPONENTS=
 /RESULT_TYPES=DERIVED
 /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=VelZ_mps
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
 /CONSTANT=0.001
;

Multiply_Signals
/SIGNAL_TYPES=DERIVED+DERIVED
 /SIGNAL_FOLDER=PROCESSED+PROCESSED
 /SIGNAL_NAMES=VelZ_mps+FP3_Mag
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
 /RESULT_NAME=PowZ
;

Event_Global_Maximum
/RESULT_EVENT_NAME=Peak_Power
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=PowZ
/SIGNAL_COMPONENTS=ALL
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=START+OFF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=PowZ
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=PP_FORCEPLATE
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
/EVENT_NAME=Peak_Power
/EVENT_INSTANCE=1
! /GENERATE_MEAN_AND_STDDEV=TRUE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Divide_Signals
/SIGNAL_TYPES=METRIC
 /SIGNAL_FOLDER=PROCESSED
 /SIGNAL_NAMES=PP_FORCEPLATE + MASS
! /COMPONENT_SEQUENCE=
! /RESULT_FOLDER=PROCESSED
/RESULT_NAME=PP_W_per_kg
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=VelZ+FP3_Mag
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=Vel@PP+Force@PP
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
/EVENT_NAME=Peak_Power
/EVENT_INSTANCE=1
! /GENERATE_MEAN_AND_STDDEV=TRUE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

! ---- Sayers Peak Anaerobic Power (PAPw) ----
Evaluate_Expression
 /EXPRESSION=((60.7 * METRIC::PROCESSED::JH_CM) + (45.3 * METRIC::PROCESSED::MASS) - 2055)
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
! /SIGNAL_COMPONENTS=
! /RESULT_TYPES=DERIVED
! /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=PAPw_SAYERS
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

! ---- Harman Average Power (optional) ----
Evaluate_Expression
 /EXPRESSION=((21.2 * METRIC::PROCESSED::JH_CM) + (23.0 * METRIC::PROCESSED::MASS) - 1393)
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
! /SIGNAL_COMPONENTS=
! /RESULT_TYPES=DERIVED
! /RESULT_FOLDERS=PROCESSED
 /RESULT_NAME=AVG_POWER_HARMAN

! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Open_Report_Template
 /REPORT_TEMPLATE=D:\Athletic Screen 2.0\Templates\AS Report.rgt
! /SET_PROMPT=Open report template
;

Select_Active_File
 /FILE_NAME=*CMJ 1*.C3D
! /QUERY=
! /SUBJECT_TAGS=NO_SUBJECT
;

Export_Data_To_Ascii_File
/FILE_NAME=D:\Athletic Screen 2.0\Output Files\CMJ1.txt
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=JH_IN+Peak_Power+Force@Peak_Power+Velo@Peak_Power+PP_FORCEPLATE+Force@PP+Vel@PP+PP_W_per_kg
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
/SIGNAL_PRECISION=1+0+2+0+1+2+2+2
! /EVENT_SEQUENCE=
/EXCLUDE_EVENTS=10s, 10s, 10s, 10s, , , , 
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /EXPORT_MEAN_AND_STD_DEV_FOR_METRIC=FALSE
! /USE_P2D_FORMAT=FALSE
! /USE_XML_FORMAT=FALSE
! /USE_JSON_FORMAT=FALSE
! /USE_SHORT_FILENAME=FALSE
! /INCLUDE_TAGS_FOR_XML=FALSE
! /EXPORT_EMPTY_SIGNALS=FALSE
! /EXPORT_WITHOUT_HEADER=FALSE
! /EXPORT_NAN=FALSE
! /CREATE_FOLDER_PATH=TRUE
! /USE_SCIENTIFIC_NOTATION=FALSE
;

