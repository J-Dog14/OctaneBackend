{
  "name": "octane-biomech-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "test:coach-performance": "node --test tests/coach-performance.test.cjs",
    "test:coach-comparison": "node --test tests/coach-comparison.test.cjs",
    "test:coach-comparison:db": "node --test tests/coach-comparison-db.integration.cjs",
    "test:populations": "node --test tests/population-snapshots.test.cjs",
    "test:client-hub": "npx --yes tsx --test tests/client-hub.test.ts",
    "hub:setup": "prisma db execute --file uais/sql/create_coach_client_hub.sql --schema prisma/schema.prisma",
    "hub:sync": "npx --yes tsx scripts/client-hub/sync.ts",
    "videos:setup": "prisma db execute --file uais/sql/create_coach_videos.sql --schema prisma/schema.prisma",
    "videos:cors": "npx --yes tsx scripts/videos/r2-cors.ts",
    "test:videos": "npx --yes tsx --test tests/videos.test.ts",
    "test:populations:db": "node --test tests/population-db.integration.cjs",
    "populations:setup": "prisma db execute --file prisma/migrations/20261014000000_coach_population_snapshots/migration.sql --schema prisma/schema.prisma",
    "populations:refresh": "npx --yes tsx scripts/percentiles/refresh.ts",
    "prisma:generate": "prisma generate",
    "prisma:db:pull": "prisma db pull",
    "prisma:studio": "prisma studio",
    "pi:setup": "npx --yes tsx scripts/pitch-intel/cli.ts setup",
    "pi:link": "npx --yes tsx scripts/pitch-intel/cli.ts link",
    "pi:pull": "npx --yes tsx scripts/pitch-intel/cli.ts pull",
    "pi:backfill": "npx --yes tsx scripts/pitch-intel/cli.ts backfill",
    "pi:import": "npx --yes tsx scripts/pitch-intel/cli.ts import",
    "pi:check": "npx --yes tsx scripts/pitch-intel/cli.ts check",
    "pi:nightly": "npx --yes tsx scripts/pitch-intel/cli.ts nightly",
    "pi:unlink": "npx --yes tsx scripts/pitch-intel/cli.ts unlink",
    "pi:list": "npx --yes tsx scripts/pitch-intel/cli.ts list",
    "pi:runs": "npx --yes tsx scripts/pitch-intel/cli.ts runs",
    "xa:check": "npx --yes tsx scripts/pitch-intel/xa-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1007.0",
    "@aws-sdk/s3-request-presigner": "^3.1007.0",
    "@clerk/nextjs": "^7.0.5",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@prisma/client": "^6.15.0",
    "@types/xml2js": "^0.4.14",
    "ag-grid-community": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "next": "^16.1.1",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.7.0",
    "swr": "^2.4.1",
    "xml2js": "^0.6.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.15.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.15.0",
    "typescript": "^5.9.0"
  }
}
